<div class="max-w-6xl mx-auto space-y-6" dir="rtl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white rounded-2xl border border-gray-100 p-4 shadow-sm">
        <div class="min-w-0">
            <h2 class="font-bold text-gray-900 truncate"><%= campaign.name %></h2>
            <p class="text-xs text-gray-400 mt-1">البيانات المعروضة مؤكدة من الخادم</p>
        </div>
        <div id="wa-status-badge" class="inline-flex self-start sm:self-auto items-center gap-2 px-3 py-2 rounded-xl border bg-gray-50 border-gray-200 text-gray-600 text-xs">
            <span id="wa-status-dot" class="w-2 h-2 rounded-full bg-gray-300"></span>
            <span id="wa-status-text">جاري التحقق</span>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3" aria-live="polite">
        <% const cards = [
            ['sent', 'تم الإرسال', 'text-brand-green'],
            ['failed', 'فشل مؤكد', 'text-red-600'],
            ['skipped', 'تم التجاوز', 'text-amber-600'],
            ['pending', 'متبقي', 'text-blue-600'],
            ['needs-review', 'يحتاج مراجعة', 'text-purple-600'],
            ['current-row', 'الصف الحالي', 'text-gray-900']
        ]; %>
        <% cards.forEach(function(card) { %>
            <div class="min-w-0 bg-white rounded-2xl border border-gray-100 p-4 shadow-sm">
                <p id="stat-<%= card[0] %>" class="text-2xl font-bold <%= card[2] %> tabular-nums">0</p>
                <p class="text-[11px] text-gray-500 mt-1 leading-5"><%= card[1] %></p>
            </div>
        <% }); %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <section class="lg:col-span-8 space-y-6 min-w-0">
            <div class="bg-white rounded-2xl border border-gray-100 p-5 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-xs text-gray-500">آخر إرسال ناجح</p>
                        <p id="last-success" class="text-sm font-medium text-gray-900 mt-1 break-words">لا يوجد بعد</p>
                    </div>
                    <p class="text-xs text-gray-500">حالة الحملة: <span id="run-status" class="font-semibold text-gray-800">جاري التحقق</span></p>
                </div>
            </div>

            <div class="bg-gray-950 rounded-2xl border border-gray-800 p-5 shadow-xl min-w-0">
                <div class="flex items-center justify-between gap-3 mb-4 border-b border-gray-800 pb-3">
                    <h3 class="text-xs font-semibold text-gray-300">سجل التحديثات المباشرة</h3>
                    <button id="clear-logs" class="text-xs text-gray-500 hover:text-white transition">مسح</button>
                </div>
                <div id="logs-area" class="h-72 overflow-y-auto overflow-x-hidden text-xs leading-6 break-words" aria-live="polite">
                    <p class="text-gray-600">في انتظار تحديثات الحملة</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-gray-100 p-5 shadow-sm">
                <h3 class="text-sm font-semibold text-gray-800 mb-4">تنزيل قوائم المتابعة</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <button type="button" data-export-status="pending" class="export-recipients border border-blue-100 bg-blue-50 text-blue-700 rounded-xl px-4 py-2.5 text-xs font-medium">تنزيل المتبقين CSV</button>
                    <button type="button" data-export-status="failed" class="export-recipients border border-red-100 bg-red-50 text-red-700 rounded-xl px-4 py-2.5 text-xs font-medium">تنزيل الفاشلين CSV</button>
                    <button type="button" data-export-status="needs_review" class="export-recipients border border-purple-100 bg-purple-50 text-purple-700 rounded-xl px-4 py-2.5 text-xs font-medium">تنزيل المراجعة CSV</button>
                </div>
            </div>
        </section>

        <aside class="lg:col-span-4 min-w-0">
            <div class="bg-white rounded-2xl border border-gray-100 p-5 shadow-sm lg:sticky lg:top-24 space-y-5">
                <div class="grid grid-cols-2 gap-3">
                    <label class="min-w-0 text-[11px] text-gray-500">من صف
                        <input type="number" id="startRow" value="<%= campaign.last_sent_row || 1 %>" min="1" class="mt-1 w-full text-sm border border-gray-200 rounded-lg p-2 focus:border-brand-green outline-none">
                    </label>
                    <label class="min-w-0 text-[11px] text-gray-500">إلى صف
                        <input type="number" id="endRow" value="<%= contactsCount || 100 %>" min="1" class="mt-1 w-full text-sm border border-gray-200 rounded-lg p-2 focus:border-brand-green outline-none">
                    </label>
                </div>

                <button id="start-btn" class="w-full bg-brand-dark text-white py-3 rounded-xl font-bold hover:opacity-95 transition">بدء الحملة</button>
                <button id="stop-btn" class="hidden w-full bg-red-50 text-red-700 border border-red-100 py-3 rounded-xl font-bold hover:bg-red-100 transition">طلب الإيقاف</button>

                <div class="pt-5 border-t border-gray-100">
                    <p class="text-xs font-semibold text-gray-800 mb-3">رسالة اختبار</p>
                    <div class="flex gap-2 min-w-0">
                        <input type="text" id="testPhone" placeholder="رقم الهاتف" class="min-w-0 flex-1 text-xs border border-gray-200 rounded-lg p-2 outline-none">
                        <button id="test-btn" class="shrink-0 bg-gray-100 text-gray-700 px-3 py-2 rounded-lg text-xs">اختبار</button>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

<script src="/js/campaign-runner.js"></script>
<script>
    var socket = io();
    initRunner(socket, '<%= campaign.id %>');
</script>
